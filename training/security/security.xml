<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">

    <record id="group_todo_user" model="res.groups">
      <field name="name">Todo / User</field>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_todo_manager" model="res.groups">
      <field name="name">Todo / Manager</field>
      <field name="implied_ids" eval="[(4, ref('group_todo_user'))]"/>
      <field name="user_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_root'))]"/>
    </record>

    <!-- User hanya melihat task miliknya sendiri -->
    <record id="rule_task_user" model="ir.rule">
      <field name="name">Task: Own Only</field>
      <field name="model_id" ref="model_training_task"/>
      <field name="domain_force">[('user_id', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('group_todo_user'))]"/>
    </record>

    <!-- Manager melihat semua task -->
    <record id="rule_task_manager" model="ir.rule">
      <field name="name">Task: All</field>
      <field name="model_id" ref="model_training_task"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_todo_manager'))]"/>
    </record>

  </data>
</odoo>
