<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ==================== VIEWS ==================== -->

    <record id="view_task_list" model="ir.ui.view">
      <field name="name">training.task.list</field>
      <field name="model">training.task</field>
      <field name="arch" type="xml">
        <list decoration-muted="is_done" string="Tasks">
          <field name="name"/>
          <field name="user_id" widget="many2one_avatar_user"/>
          <field name="description" optional="show"/>
          <field name="is_done" widget="boolean_toggle"/>
        </list>
      </field>
    </record>

    <record id="view_task_form" model="ir.ui.view">
      <field name="name">training.task.form</field>
      <field name="model">training.task</field>
      <field name="arch" type="xml">
        <form string="Task">
          <sheet>
            <widget name="web_ribbon" title="Done" bg_color="bg-success" invisible="not is_done"/>
            <div class="oe_title">
              <h1><field name="name" placeholder="Nama task..."/></h1>
            </div>
            <group>
              <field name="user_id" widget="many2one_avatar_user"/>
              <field name="is_done" widget="boolean_toggle"/>
            </group>
            <field name="description" placeholder="Deskripsi (opsional)..."/>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_task_kanban" model="ir.ui.view">
      <field name="name">training.task.kanban</field>
      <field name="model">training.task</field>
      <field name="arch" type="xml">
        <kanban>
          <field name="name"/>
          <field name="user_id"/>
          <field name="is_done"/>
          <templates>
            <t t-name="card">
              <strong><field name="name"/></strong>
              <div class="mt-2 d-flex justify-content-between align-items-center">
                <span t-att-class="record.is_done.raw_value ? 'text-success' : 'text-warning'">
                  <i t-att-class="record.is_done.raw_value ? 'fa fa-check' : 'fa fa-clock-o'"/>
                  <t t-esc="record.is_done.raw_value ? 'Selesai' : 'Belum'"/>
                </span>
                <field name="user_id" widget="many2one_avatar_user"/>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="view_task_search" model="ir.ui.view">
      <field name="name">training.task.search</field>
      <field name="model">training.task</field>
      <field name="arch" type="xml">
        <search>
          <field name="name"/>
          <field name="user_id"/>
          <filter name="my_tasks"   string="My Tasks" domain="[('user_id','=',uid)]"/>
          <filter name="done"       string="Done"     domain="[('is_done','=',True)]"/>
          <filter name="todo"       string="To Do"    domain="[('is_done','=',False)]"/>
          <separator/>
          <filter name="by_user" string="Group by User" context="{'group_by':'user_id'}"/>
        </search>
      </field>
    </record>

    <!-- ==================== ACTION & MENU ==================== -->

    <record id="action_task" model="ir.actions.act_window">
      <field name="name">Todo Tasks</field>
      <field name="res_model">training.task</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="context">{'search_default_todo': 1}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Buat task pertamamu!</p>
      </field>
    </record>

    <menuitem id="menu_root"  name="Todo List" sequence="10"/>
    <menuitem id="menu_tasks" name="Tasks" parent="menu_root" action="action_task"/>

  </data>
</odoo>
