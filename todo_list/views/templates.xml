<odoo>
  <data>
    <template id="halaman_tugas_ui" name="Todo List">
      <t t-call="website.layout">
        <div id="wrap" class="container py-5">
          <h1 class="fw-bold mb-4">Daftar Tugas</h1>
          <div class="row g-4">
            <t t-foreach="tasks" t-as="task">
              <div class="col-md-4">
                <div class="card h-100 shadow-sm rounded-4 border-0">
                  <div class="card-body">
                    <h5 class="fw-bold"><t t-esc="task.name"/></h5>
                    <p class="text-muted small"><t t-esc="task.description or 'Tidak ada deskripsi.'"/></p>
                  </div>
                  <div class="card-footer bg-white border-0 pb-3">
                    <t t-if="task.is_done">
                      <span class="badge text-bg-success rounded-pill"><i class="fa fa-check"/> Selesai</span>
                    </t>
                    <t t-else="">
                      <span class="badge text-bg-warning rounded-pill"><i class="fa fa-clock-o"/> Belum</span>
                    </t>
                  </div>
                </div>
              </div>
            </t>
          </div>
          <div t-if="not tasks" class="alert alert-info mt-4 rounded-4">
            Belum ada tugas. Buat lewat backend dulu!
          </div>
        </div>
      </t>
    </template>
  </data>
</odoo>
